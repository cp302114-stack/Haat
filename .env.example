# Copy to .env and fill in from the Aiven console. Never commit .env.
# Leave a service blank and the app uses a clearly labelled local stand-in for it.

PORT=3000

# --- Aiven for PostgreSQL ---------------------------------------------------
# Service URI from the PostgreSQL overview page.
DATABASE_URL=postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require
# Optional: path to the project CA (ca.pem) or the PEM text itself.
# If blank, the connection is encrypted but the server certificate is not verified.
PG_CA=

# --- Aiven for Apache Kafka -------------------------------------------------
# host:port of the Kafka service (comma separated if more than one).
KAFKA_BROKERS=HOST:PORT
# Option A: client certificate auth. Paths to the three files from the console
# (or the PEM text itself).
KAFKA_CA=./certs/ca.pem
KAFKA_CERT=./certs/service.cert
KAFKA_KEY=./certs/service.key
# Option B: SASL auth (leave A blank). Mechanism is plain, scram-sha-256 or scram-sha-512.
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Topic prefix and replication factor (Aiven free plan is a single node).
KAFKA_TOPIC_PREFIX=haat
KAFKA_REPLICATION=1

# --- Aiven for OpenSearch ---------------------------------------------------
# Service URI from the OpenSearch overview page, with credentials in it.
OPENSEARCH_URL=https://avnadmin:PASSWORD@HOST:PORT
OPENSEARCH_INDEX=haat-products
# Optional: project CA (path or PEM text). If blank, TLS is on but the certificate is not verified.
OPENSEARCH_CA=
